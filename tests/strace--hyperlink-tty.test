#!/bin/sh -efu
#
# Check --hyperlink=auto with a tty.
#
# Copyright (c) 2026 The strace developers.
# All rights reserved.
#
# SPDX-License-Identifier: GPL-2.0-or-later

. "${srcdir=.}/init.sh"

check_prog script
run_prog ../getpid > /dev/null

TERM=linux
export TERM

cmd="../getpid > /dev/null"
set -- script -q -e -c "$cmd" /dev/null
"$@" || framework_skip_ "$* failed with code $?"

osc8_prefix="$(printf '\033]8;;')"
osc8_getpid_begin="$(printf '\033]8;;%s\033\\\\' 'https://man7\.org/linux/man-pages/man2/getpid\.2\.html')"
osc8_end="$(printf '\033]8;;\033\\\\')"

# Links are off by default, even on a tty.
printf '%s\n' "!.*${osc8_prefix}.*" > "$EXP"
cmd="$STRACE --trace=getpid ../getpid > /dev/null"
set -- script -q -e -c "$cmd" /dev/null
"$@" > "$LOG" || dump_log_and_fail_with "$* failed with code $?"
match_grep "$LOG" "$EXP"

cmd="$STRACE --trace=getpid --hyperlink=never ../getpid > /dev/null"
set -- script -q -e -c "$cmd" /dev/null
"$@" > "$LOG" || dump_log_and_fail_with "$* failed with code $?"
match_grep "$LOG" "$EXP"

printf '%s\n' ".*${osc8_getpid_begin}getpid${osc8_end}.*" > "$EXP"

# Bare --hyperlink and --hyperlink=auto both enable links on a tty.
for option in --hyperlink --hyperlink=auto; do
	cmd="$STRACE --trace=getpid $option ../getpid > /dev/null"
	set -- script -q -e -c "$cmd" /dev/null
	"$@" > "$LOG" || dump_log_and_fail_with "$* failed with code $?"
	match_grep "$LOG" "$EXP"
done

# Auto rejects unsupported or unset TERM values.
cmd="$STRACE --trace=getpid --hyperlink=auto ../getpid > /dev/null"
set -- script -q -e -c "$cmd" /dev/null
printf '%s\n' "!.*${osc8_prefix}.*" > "$EXP"
for term in dumb unknown ''; do
	TERM=$term
	export TERM
	"$@" > "$LOG" || dump_log_and_fail_with "$* failed with code $?"
	match_grep "$LOG" "$EXP"
done

unset TERM
"$@" > "$LOG" || dump_log_and_fail_with "$* failed with code $?"
match_grep "$LOG" "$EXP"

# Explicit always mode still emits links on a dumb tty.
TERM=dumb
export TERM
cmd="$STRACE --trace=getpid --hyperlink=always ../getpid > /dev/null"
set -- script -q -e -c "$cmd" /dev/null
printf '%s\n' ".*${osc8_getpid_begin}getpid${osc8_end}.*" > "$EXP"
"$@" > "$LOG" || dump_log_and_fail_with "$* failed with code $?"
match_grep "$LOG" "$EXP"
