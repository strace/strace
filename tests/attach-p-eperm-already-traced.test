#!/bin/sh
#
# Check that strace -p reports an existing tracer when EPERM is due to
# the target process already being traced.
#
# Copyright (c) 2026 The strace developers.
# All rights reserved.
#
# SPDX-License-Identifier: GPL-2.0-or-later

. "${srcdir=.}/init.sh"

check_prog mkfifo
mkfifo "$OUT.pid" "$OUT.done" ||
	framework_skip_ 'mkfifo failed'
exec 3<> "$OUT.pid" &&
exec 4<> "$OUT.done" ||
	framework_skip_ 'mkfifo redirection failed'

$STRACE -qq --trace=none --signal=none -- \
	sh -c 'echo $$ >&3; exec 3>&-; read -r released <&4' &
tracer_pid=$!
trap 'echo "done" >&4' 0

pid_timeout=$((TIMEOUT_DURATION / 100))
[ "$pid_timeout" -ge 5 ] || pid_timeout=5
timeout_cmd="timeout -k 5 $pid_timeout"
$timeout_cmd true > /dev/null 2>&1 || timeout_cmd=

tracee_pid=$($timeout_cmd sh -c '
	read -r pid <&3 && printf "%s\n" "$pid"
') || fail_ 'failed to read tracee pid'
exec 3>&-
[ "$tracee_pid" -gt 0 ] ||
	fail_ "background $STRACE failed to start"

$STRACE -p "$tracee_pid" 2>"$LOG" &&
	dump_log_and_fail_with "$STRACE -p $tracee_pid should have failed"

echo "done" >&4 || fail_ 'failed to release tracee'
trap - 0
exec 4>&-
wait "$tracer_pid" || fail_ "background $STRACE failed"

rm -f -- "$OUT.pid" "$OUT.done"

for cmd in PTRACE_SEIZE PTRACE_ATTACH; do
	cat > "$EXP" <<__EOF__
$STRACE_EXE: attach: ptrace($cmd, $tracee_pid): Operation not permitted
$STRACE_EXE: Process $tracee_pid is already being traced by pid $tracer_pid
__EOF__
	diff -u -- "$EXP" "$LOG" ||
		continue
	exit 0
done
dump_log_and_fail_with "unexpected $STRACE -p $tracee_pid output"
