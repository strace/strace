if [ "${STRACE_TEST_PIDNS-}" != 1 ]; then
	unshare -Urpf -- true || exit 77
	exec unshare -Urpf -- env STRACE_TEST_PIDNS=1 "$0"
fi

. "${srcdir=.}/attach-p-eperm-already-traced.test"
