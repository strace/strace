#!/bin/sh -efu
#
# Check that explicit clone3 injection produces INJECTED annotation.
#
# Copyright (c) 2026 The strace developers.
# All rights reserved.
#
# SPDX-License-Identifier: GPL-2.0-or-later

. "${srcdir=.}/scno_tampering.sh"
. "${srcdir=.}/filter_seccomp.sh"

check_prog grep

NAME=clone3_untraced
run_prog
run_strace --seccomp-bpf -f -e trace=clone3,chdir \
	-e inject=clone3:when=2:error=EPERM ../$NAME > /dev/null

grep -qF 'INJECTED' "$LOG" ||
	dump_log_and_fail_with "explicit clone3 injection was not applied"

grep -qF 'chdir("clone3 skipped"' "$LOG" ||
	dump_log_and_fail_with "clone3 injection did not reach the program"
