#!/bin/sh
#
# Check restart_syscall decoding.
#
# Copyright (c) 2015-2026 The strace developers.
# All rights reserved.
#
# SPDX-License-Identifier: GPL-2.0-or-later

. "${srcdir=.}/init.sh"

run_prog ../sleep 0

../set_ptracer_any ../sleep 2 > /dev/null &
tracee_pid=$!

../sleep 1

run_strace -qq -a14 -e trace=restart_syscall,exit_group -p $tracee_pid

# On Alpha, the expectation depends on the ptrace API used by strace.
check_prog grep
case "$STRACE_ARCH" in
mips)	syscall='system call' ;;
alpha)
	if $STRACE -d -enone / 2>&1 >/dev/null |
	   grep -qx '[^:]*strace: PTRACE_GET_SYSCALL_INFO works'; then
		syscall='system call'
	else
		skip_ 'unreliable Alpha attach without PTRACE_GET_SYSCALL_INFO'
	fi ;;
*)	syscall=nanosleep ;;
esac

cat > "$EXP" <<__EOF__
restart_syscall(<... resuming interrupted $syscall ...>) = 0
exit_group(0) = ?
__EOF__

match_diff "$LOG" "$EXP"
